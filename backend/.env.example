# ──────────────────────────────────────────────────────────────────────────────
# Veyra AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
APP_NAME=Veyra AI
APP_VERSION=1.0.0
DEBUG=False

# ── Database ─────────────────────────────────────────────────────────────────
# Example Cloud MySQL: mysql+pymysql://user:password@host:port/dbname
# Example Cloud PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pathpilot_ai
DATABASE_SSL=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array or comma-separated list of allowed frontend origins
CORS_ORIGINS=["https://veyra3.netlify.app","http://localhost:5173","http://127.0.0.1:5173"]

# ── AI / LLM ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Auth / JWT ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

